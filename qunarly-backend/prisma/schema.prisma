generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String             @id @default(uuid())
  email                 String?            @unique
  phone                 String?            @unique
  passwordHash          String
  role                  UserRole
  status                UserStatus         @default(ACTIVE)
  createdAt             DateTime           @default(now())
  districtId            String?
  regionId              String?
  avatarUrl             String?
  bio                   String?
  displayName           String?
  publicProfile         Boolean            @default(true)
  ratingStats           Json?
  homeLat               Float?
  homeLng               Float?
  homeAddressText       String?
  homeRegion            String?
  homeUpdatedAt         DateTime?
  settlementId          String?
  expoPushToken         String?
  addressPoints         AddressPoint[]
  carrierProfile        CarrierProfile?
  createdVillages       CommunityVillage[] @relation("VillageCreatedBy")
  dealsAsBuyer          Deal[]             @relation("DealBuyer")
  dealsAsSeller         Deal[]             @relation("DealSeller")
  deliveryLegs          DeliveryLeg[]      @relation("DeliveryLegDriver")
  driverProfile         Driver?
  driverOffers          DriverOffer[]
  driverQueues          DriverQueue[]
  executorProfile       ExecutorProfile?
  fieldJobsAccepted     FieldJob[]         @relation("FieldJobAccepted")
  fieldJobs             FieldJob[]         @relation("FieldJobFarmer")
  files                 File[]
  handoffTokensReceived HandoffToken[]     @relation("HandoffTokenReceiver")
  notifications         Notification[]
  offers                Offer[]            @relation("OfferBuyer")
  ordersAsBuyer         Order[]            @relation("OrderBuyer")
  ordersAsSeller        Order[]            @relation("OrderSeller")
  listingsAsSeller      ProductListing[]   @relation("ListingSeller")
  profile               Profile?
  refreshTokens         RefreshToken[]
  assignedRides         RideRequest[]      @relation("RideAssignedDriver")
  rideRequests          RideRequest[]      @relation("RidePassenger")
  tripSessionsAsDriver  TripSession[]      @relation("TripSessionDriver")
  tripBookings          TripBooking[]      @relation("TripBookingPassenger")
  shipmentsTaken        ShipmentJob[]      @relation("ShipmentAccepted")
  shipments             ShipmentJob[]      @relation("ShipmentRequester")
  createdRoutes         TaxiRoute[]        @relation("TaxiRouteCreator")
  dropPicksDropped      DropPick[]         @relation("DropPickDroppedBy")
  dropPicksPickedUp     DropPick[]         @relation("DropPickPickupBy")
  orderDisputesOpened   OrderDispute[]     @relation("OrderDisputeOpenedBy")
  orderDisputesClosed   OrderDispute[]     @relation("OrderDisputeClosedBy")
  refundFlagsCreated    RefundFlag[]
  district              District?          @relation(fields: [districtId], references: [id])
  region                Region?            @relation("UserRegion", fields: [regionId], references: [id])
  settlement            CommunityVillage?  @relation("UserHomeVillage", fields: [settlementId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model Profile {
  userId       String  @id
  name         String
  regionId     String?
  lat          Float?
  lng          Float?
  avatarFileId String?
  farmName     String?
  avatarFile   File?   @relation(fields: [avatarFileId], references: [id])
  region       Region? @relation(fields: [regionId], references: [id])
  user         User    @relation(fields: [userId], references: [id])
}

model Region {
  id                String             @id @default(uuid())
  name              String
  parentId          String?
  communityVillages CommunityVillage[]
  districts         District[]
  hubs              Hub[]
  profiles          Profile[]
  parent            Region?            @relation("RegionParent", fields: [parentId], references: [id])
  children          Region[]           @relation("RegionParent")
  usersAsRegion     User[]             @relation("UserRegion")

  @@unique([name, parentId])
}

model District {
  id                String             @id @default(uuid())
  name              String
  regionId          String
  createdAt         DateTime           @default(now())
  communityVillages CommunityVillage[]
  hubs              Hub[]
  region            Region             @relation(fields: [regionId], references: [id])
  settlements       Settlement[]
  users             User[]

  @@unique([name, regionId])
}

model Settlement {
  id         String   @id @default(uuid())
  name       String
  districtId String
  createdAt  DateTime @default(now())
  district   District @relation(fields: [districtId], references: [id])

  @@unique([name, districtId])
}

model CommunityVillage {
  id              String                 @id @default(uuid())
  nameDisplay     String
  nameNormalized  String
  districtId      String
  regionId        String
  lat             Float
  lng             Float
  status          CommunityVillageStatus @default(PENDING)
  createdByUserId String?
  createdAt       DateTime               @default(now())
  createdByUser   User?                  @relation("VillageCreatedBy", fields: [createdByUserId], references: [id])
  district        District               @relation(fields: [districtId], references: [id])
  region          Region                 @relation(fields: [regionId], references: [id])
  users           User[]                 @relation("UserHomeVillage")

  @@unique([nameNormalized, districtId])
}

model TaxiRoute {
  id              String          @id @default(uuid())
  fromHubId       String
  toHubId         String
  createdAt       DateTime        @default(now())
  autoCreated     Boolean         @default(false)
  pairId          String?
  routeType       RouteType       @default(VILLAGE_TO_DISTRICT)
  status          RouteStatus     @default(INACTIVE)
  createdByUserId String?
  offers          DriverOffer[]
  queues          DriverQueue[]
  requests        RideRequest[]
  tripSessions    TripSession[]
  createdByUser   User?           @relation("TaxiRouteCreator", fields: [createdByUserId], references: [id])
  fromHub         Hub             @relation("TaxiRouteFrom", fields: [fromHubId], references: [id])
  toHub           Hub             @relation("TaxiRouteTo", fields: [toHubId], references: [id])

  @@unique([fromHubId, toHubId, routeType])
}

model DriverQueue {
  id               String            @id @default(uuid())
  driverId         String
  routeId          String
  status           DriverQueueStatus @default(IN_QUEUE)
  joinedAt         DateTime          @default(now())
  availableSeats   Int               @default(4)
  capacity         Int               @default(4)
  expiresAt        DateTime?
  lastPingAt       DateTime?
  calledExpiresAt  DateTime?
  driver           User              @relation(fields: [driverId], references: [id])
  route            TaxiRoute         @relation(fields: [routeId], references: [id])
  queueEvents      QueueEvent[]

  @@unique([driverId, routeId])
}

model QueueEvent {
  id        String   @id @default(uuid())
  queueId   String
  eventType String
  metaJson  Json?
  createdAt DateTime @default(now())
  queue     DriverQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
}

model RideRequest {
  id               String            @id @default(uuid())
  routeId          String
  passengerId      String
  pickupText       String
  seats            Int               @default(1)
  status           RideRequestStatus @default(PENDING)
  assignedDriverId String?
  currentOfferId   String?
  clientRequestId  String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  cargoType        CargoType
  departureType    DepartureType
  waitUntilFull    Boolean           @default(false)
  offers           DriverOffer[]
  assignedDriver   User?             @relation("RideAssignedDriver", fields: [assignedDriverId], references: [id])
  passenger        User              @relation("RidePassenger", fields: [passengerId], references: [id])
  route            TaxiRoute         @relation(fields: [routeId], references: [id])
}

model DriverOffer {
  id        String            @id @default(uuid())
  requestId String
  driverId  String
  routeId   String
  status    DriverOfferStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  driver    User              @relation(fields: [driverId], references: [id])
  request   RideRequest       @relation(fields: [requestId], references: [id])
  route     TaxiRoute         @relation(fields: [routeId], references: [id])

  @@unique([requestId, driverId])
}

model TripSession {
  id           String            @id @default(uuid())
  driverId     String
  routeId      String
  status       TripSessionStatus @default(OPEN)
  totalSeats   Int
  bookedSeats  Int               @default(0)
  expiresAt    DateTime?
  closingUntil DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  driver       User              @relation("TripSessionDriver", fields: [driverId], references: [id])
  route        TaxiRoute         @relation(fields: [routeId], references: [id])
  bookings     TripBooking[]
}

model TripBooking {
  id          String            @id @default(uuid())
  tripId      String
  passengerId String
  seatCount   Int
  status      TripBookingStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  trip        TripSession       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passenger   User              @relation("TripBookingPassenger", fields: [passengerId], references: [id])

  @@unique([tripId, passengerId])
}

model OfferAcceptIdempotency {
  id           String   @id @default(uuid())
  actionId     String   @unique
  offerId      String
  responseJson Json
  createdAt    DateTime @default(now())
}

model Hub {
  id             String          @id @default(cuid())
  name           String
  normalizedName String          @default("")
  lat            Float
  lng            Float
  radiusKm       Float           @default(0.8)
  isActive       Boolean         @default(true)
  districtId     String?
  regionId       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  district       District?       @relation(fields: [districtId], references: [id], onDelete: SetNull)
  region         Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  routesFrom     RouteTemplate[] @relation("HubRoutesFrom")
  routesTo       RouteTemplate[] @relation("HubRoutesTo")
  taxiRoutesFrom TaxiRoute[]     @relation("TaxiRouteFrom")
  taxiRoutesTo   TaxiRoute[]     @relation("TaxiRouteTo")
}

model RouteTemplate {
  id           String       @id @default(cuid())
  name         String?
  fromHubId    String
  toHubId      String
  scheduleType ScheduleType @default(QUEUE)
  typicalPrice Float?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  fromHub      Hub          @relation("HubRoutesFrom", fields: [fromHubId], references: [id])
  toHub        Hub          @relation("HubRoutesTo", fields: [toHubId], references: [id])

  @@unique([fromHubId, toHubId])
}

model File {
  id            String          @id @default(uuid())
  ownerId       String
  type          String
  url           String
  metaJson      Json?
  createdAt     DateTime        @default(now())
  entityId      String?
  entityType    FileEntityType?
  owner         User            @relation(fields: [ownerId], references: [id])
  listingImages ListingImage[]
  Profile       Profile[]
}

model ProductListing {
  id                 String               @id @default(uuid())
  sellerId           String
  category           String
  title              String
  description        String?
  quantity           Float
  unit               String
  priceType          String?
  priceMin           Float?
  priceMax           Float?
  regionId           String?
  lat                Float?
  lng                Float?
  status             ProductListingStatus @default(DRAFT)
  createdAt          DateTime             @default(now())
  addressText        String?
  currency           String
  price              Float
  districtId         String?
  customCategoryName String?
  reservedQty        Float                @default(0)
  deals              Deal[]
  images             ListingImage[]
  offers             Offer[]
  orders             Order[]
  priceTiers         ProductPriceTier[]
  seller             User                 @relation("ListingSeller", fields: [sellerId], references: [id])
}

model ProductPriceTier {
  id                String         @id @default(uuid())
  productListingId  String
  minQty            Float
  maxQty            Float?
  unitPrice         Float
  currency          String
  createdAt         DateTime       @default(now())
  productListing    ProductListing @relation(fields: [productListingId], references: [id], onDelete: Cascade)
}

model ListingImage {
  id        String         @id @default(uuid())
  listingId String
  fileId    String
  sortOrder Int
  createdAt DateTime       @default(now())
  file      File           @relation(fields: [fileId], references: [id])
  listing   ProductListing @relation(fields: [listingId], references: [id])
}

model Offer {
  id        String         @id @default(uuid())
  listingId String
  buyerId   String
  quantity  Float
  unitPrice Float
  status    OfferStatus    @default(SENT)
  createdAt DateTime       @default(now())
  message   String?
  buyer     User           @relation("OfferBuyer", fields: [buyerId], references: [id])
  listing   ProductListing @relation(fields: [listingId], references: [id])
}

model Deal {
  id                 String             @id @default(uuid())
  listingId          String
  sellerId           String
  buyerId            String
  agreedQuantity     Float
  agreedUnitPrice    Float
  status             DealStatus         @default(NEGOTIATING)
  createdAt          DateTime           @default(now())
  cargoWeightKg      Float?
  cargoVolumeM3      Float?
  cargoType          String?
  pickupLat          Float?
  pickupLng          Float?
  pickupAddressText  String?
  dropoffLat         Float?
  dropoffLng         Float?
  dropoffAddressText String?
  pickupRegion       String?
  dropoffRegion      String?
  buyer              User               @relation("DealBuyer", fields: [buyerId], references: [id])
  listing            ProductListing     @relation(fields: [listingId], references: [id])
  seller             User               @relation("DealSeller", fields: [sellerId], references: [id])
  shipmentLinks      DealShipmentLink[]
}

model Order {
  id               String             @id @default(uuid())
  listingId        String?
  sellerId         String
  buyerId          String
  quantity         Float?
  unitPrice        Float?
  totalPrice       Float?
  status           OrderStatus        @default(PLACED)
  commerceStatus   CommerceOrderStatus @default(PAYMENT_PENDING)
  payoutJson       Json?
  currency         String?
  deliveryFee      Float?
  deliveryOption   String?
  destLat          Float?
  destLng          Float?
  destinationText  String?
  productSubtotal  Float?
  totalAmount      Float?
  createdAt        DateTime           @default(now())
  idempotencyKey   String?
  deliveryRecord   Delivery?
  legs             DeliveryLeg[]
  delivery         DeliveryRequest?
  shipmentJob      ShipmentJob?
  commissionRecord CommissionRecord?
  disputes         OrderDispute[]
  refundFlags      RefundFlag[]
  buyer            User               @relation("OrderBuyer", fields: [buyerId], references: [id])
  listing          ProductListing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  seller           User               @relation("OrderSeller", fields: [sellerId], references: [id])

  @@unique([buyerId, idempotencyKey])
}

model OrderDispute {
  id             String             @id @default(uuid())
  orderId        String
  status         DisputeStatus      @default(OPEN)
  reason         String
  resolution     DisputeResolution?
  resolutionNote String?
  openedByUserId String?
  closedByUserId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  closedAt       DateTime?
  order          Order              @relation(fields: [orderId], references: [id])
  openedBy       User?              @relation("OrderDisputeOpenedBy", fields: [openedByUserId], references: [id])
  closedBy       User?              @relation("OrderDisputeClosedBy", fields: [closedByUserId], references: [id])
}

model RefundFlag {
  id              String   @id @default(uuid())
  orderId         String
  reason          String
  createdByUserId String?
  createdAt       DateTime @default(now())
  order           Order    @relation(fields: [orderId], references: [id])
  createdBy       User?    @relation(fields: [createdByUserId], references: [id])
}

model DeliveryRequest {
  id              String                @id @default(uuid())
  orderId         String                @unique
  originText      String
  destinationText String
  originLat       Float?
  originLng       Float?
  destLat         Float?
  destLng         Float?
  distanceKm      Float?
  status          DeliveryRequestStatus @default(CREATED)
  createdAt       DateTime              @default(now())
  deliveryRecord  Delivery?
  legs            DeliveryLeg[]
  order           Order                 @relation(fields: [orderId], references: [id])
}

model DeliveryLeg {
  id            String            @id @default(uuid())
  orderId       String
  requestId     String
  fromLocation  String
  toLocation    String
  fromLat       Float?
  fromLng       Float?
  toLat         Float?
  toLng         Float?
  driverId      String?
  price         Float
  status        DeliveryLegStatus @default(OFFERING)
  sortOrder     Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  completedAt   DateTime?
  deliveryId    String?
  fromHubId     String?
  toHubId       String?
  arrivedHubId  String?
  acceptedAt    DateTime?
  arrivedAt     DateTime?
  arrivedLat    Float?
  arrivedLng    Float?
  handedOffAt   DateTime?
  startedAt     DateTime?
  delivery      Delivery?         @relation(fields: [deliveryId], references: [id])
  driver        User?             @relation("DeliveryLegDriver", fields: [driverId], references: [id])
  order         Order             @relation(fields: [orderId], references: [id])
  request          DeliveryRequest   @relation(fields: [requestId], references: [id])
  handoffTokens    HandoffToken[]
  handoffsFrom     Handoff[]         @relation("HandoffFrom")
  handoffsTo       Handoff[]         @relation("HandoffTo")
}

model Delivery {
  id         String           @id @default(uuid())
  orderId    String?          @unique
  shipmentId String?          @unique
  requestId  String?          @unique
  createdAt  DateTime         @default(now())
  order      Order?           @relation(fields: [orderId], references: [id])
  request    DeliveryRequest? @relation(fields: [requestId], references: [id])
  shipment   ShipmentJob?     @relation(fields: [shipmentId], references: [id])
  legs       DeliveryLeg[]
}

model HandoffToken {
  id             String      @id @default(uuid())
  legId          String
  receiverUserId String
  tokenHash      String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime    @default(now())
  leg            DeliveryLeg @relation(fields: [legId], references: [id])
  receiver       User        @relation("HandoffTokenReceiver", fields: [receiverUserId], references: [id])
}

model Driver {
  id            String          @id @default(uuid())
  userId        String          @unique
  driverType    DriverType      @default(VILLAGE_TO_CITY)
  homeRegion    String?
  routeCorridor String?
  vehicleType   String?
  capacityKg    Float           @default(0)
  user          User            @relation(fields: [userId], references: [id])
  location      DriverLocation?
}

model DriverLocation {
  driverId  String   @id
  lat       Float
  lng       Float
  heading   Float?
  speed     Float?
  updatedAt DateTime @updatedAt
  driver    Driver   @relation(fields: [driverId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  dataJson  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AddressPoint {
  id           String   @id @default(uuid())
  userId       String?
  lat          Float
  lng          Float
  street       String?
  houseNumber  String?
  locality     String?
  source       String   @default("user_contributed")
  confirmCount Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id])
}

model DealShipmentLink {
  id         String      @id @default(uuid())
  dealId     String
  shipmentId String
  createdAt  DateTime    @default(now())
  deal       Deal        @relation(fields: [dealId], references: [id])
  shipment   ShipmentJob @relation(fields: [shipmentId], references: [id])
}

model ServiceType {
  id        String     @id @default(uuid())
  name      String
  baseRate  Float
  fieldJobs FieldJob[]
}

model ExecutorProfile {
  userId         String  @id
  serviceTypeIds Json
  regions        Json
  isActive       Boolean @default(true)
  user           User    @relation(fields: [userId], references: [id])
}

model FieldJob {
  id                String         @id @default(uuid())
  farmerId          String
  serviceTypeId     String
  areaHa            Float
  lat               Float
  lng               Float
  priceEstimate     Float
  status            FieldJobStatus @default(CREATED)
  acceptedBy        String?
  notes             String?
  pickupAddressText String?
  cargoWeightKg     Float?
  cargoVolumeM3     Float?
  cargoType         String?
  pickupRegion      String?
  acceptedUser      User?          @relation("FieldJobAccepted", fields: [acceptedBy], references: [id])
  farmer            User           @relation("FieldJobFarmer", fields: [farmerId], references: [id])
  serviceType       ServiceType    @relation(fields: [serviceTypeId], references: [id])
}

model CarrierProfile {
  userId           String  @id
  vehicleTypes     Json
  capacityKg       Float
  regions          Json
  isActive         Boolean @default(true)
  maxWeightKg      Float   @default(0)
  maxVolumeM3      Float?
  vehicleType      String?
  refrigerated     Boolean @default(false)
  livestockAllowed Boolean @default(false)
  closedBody       Boolean @default(false)
  user             User    @relation(fields: [userId], references: [id])
}

model ShipmentJob {
  id                String              @id @default(uuid())
  requesterId       String
  dealId            String?
  orderId           String?             @unique
  originLat         Float
  originLng         Float
  destLat           Float
  destLng           Float
  cargoJson         Json
  status            ShipmentJobStatus   @default(CREATED)
  acceptedBy        String?
  originAddressText String?
  destAddressText   String?
  cargoWeightKg     Float?
  cargoVolumeM3     Float?
  cargoType         String?
  originRegion      String?
  destRegion        String?
  packageType       String?
  cargoNotes        String?
  sourceId          String?
  distanceKm        Float?
  estimatedPrice    Float?
  finalPrice        Float?
  pricingJson       Json?
  sourceType        LogisticsSourceType @default(MANUAL)
  shipmentLinks     DealShipmentLink[]
  deliveryRecord    Delivery?
  order             Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  acceptedUser      User?               @relation("ShipmentAccepted", fields: [acceptedBy], references: [id])
  requester         User                @relation("ShipmentRequester", fields: [requesterId], references: [id])
}

model ProofEvent {
  id              String         @id @default(uuid())
  eventKey        String?        @unique
  eventType       ProofEventType
  entityType      ProofEntityType
  entityId        String
  actorUserId     String?
  orderId         String?
  deliveryId      String?
  requestId       String?
  legId           String?
  handoffId       String?
  dropPickId      String?
  lat             Float?
  lng             Float?
  clientCreatedAt DateTime?
  createdAt       DateTime       @default(now())
  metaJson        Json?
  handoff         Handoff?       @relation(fields: [handoffId], references: [id], onDelete: SetNull)
  dropPick        DropPick?      @relation(fields: [dropPickId], references: [id], onDelete: SetNull)
}

enum ProofEventType {
  LEG_OFFERED
  LEG_ACCEPTED
  LEG_STARTED
  LEG_ARRIVED
  HANDOFF_FROM_CONFIRMED
  HANDOFF_TO_CONFIRMED
  HANDOFF_COMPLETED
  DROP_PICK_DROPPED
  DROP_PICK_PICKED_UP
  LEG_COMPLETED
}

enum ProofEntityType {
  ORDER
  DELIVERY
  REQUEST
  LEG
  HANDOFF
  DROP_PICK
}

enum HandoffMethod {
  LIVE
  DROP_PICK
}

enum HandoffStatus {
  PENDING
  FROM_CONFIRMED
  TO_CONFIRMED
  COMPLETED
  EXPIRED
}

enum DropPickStatus {
  DROPPED
  PICKED_UP
  EXPIRED
}

enum FraudSignalStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum FraudSignalType {
  MULTIPLE_ORDERS_IP
  CANCEL_THRESHOLD
  MANUAL_REVIEW
}

enum DisputeResolution {
  REFUND_REQUESTED
  REFUND_DENIED
  ORDER_CANCELLED
  ORDER_CONTINUE
}

enum DisputeStatus {
  OPEN
  CLOSED
}

enum AccessListType {
  BLACKLIST
  WHITELIST
}

enum AccessListTarget {
  USER_ID
  PHONE
  EMAIL
  DEVICE_ID
  IP_HASH
}

enum CommissionScope {
  GLOBAL
  CATEGORY
  REGION
}

model Handoff {
  id             String        @id @default(uuid())
  fromLegId      String        @unique
  toLegId        String        @unique
  method         HandoffMethod @default(LIVE)
  status         HandoffStatus @default(PENDING)
  senderLat      Float?
  senderLng      Float?
  receiverLat    Float?
  receiverLng    Float?
  fromConfirmedAt DateTime?
  toConfirmedAt   DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  fromLeg       DeliveryLeg   @relation("HandoffFrom", fields: [fromLegId], references: [id], onDelete: Cascade)
  toLeg         DeliveryLeg   @relation("HandoffTo", fields: [toLegId], references: [id], onDelete: Cascade)
  dropPick      DropPick?
  proofEvents   ProofEvent[]
}

model DropPick {
  id             String         @id @default(uuid())
  handoffId      String         @unique
  status         DropPickStatus @default(DROPPED)
  droppedById    String
  droppedAt      DateTime
  dropLat        Float
  dropLng        Float
  dropPhoto1Id   String
  dropPhoto2Id   String
  pickupTokenHash String
  pickupExpiresAt DateTime
  pickupById     String?
  pickupAt       DateTime?
  pickupLat      Float?
  pickupLng      Float?
  pickupPhoto1Id String?
  pickupPhoto2Id String?
  createdAt      DateTime       @default(now())
  handoff        Handoff        @relation(fields: [handoffId], references: [id], onDelete: Cascade)
  droppedBy      User           @relation("DropPickDroppedBy", fields: [droppedById], references: [id], onDelete: Cascade)
  pickupBy       User?          @relation("DropPickPickupBy", fields: [pickupById], references: [id], onDelete: SetNull)
  proofEvents    ProofEvent[]
}

model FraudSignal {
  id        String           @id @default(uuid())
