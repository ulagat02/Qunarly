    # \uc0\u1041 \u1083 \u1086 \u1082 \u1095 \u1077 \u1081 \u1085 \u1085 \u1110 \u1187  \u1078 \u1072 \u1088 \u1072 \u1084 \u1076 \u1099 \u1083 \u1099 \u1171 \u1099 \u1085  \u1090 \u1077 \u1082 \u1089 \u1077 \u1088 \u1091 \
    if blockchain.is_chain_valid():\
        print("\uc0\u1041 \u1083 \u1086 \u1082 \u1095 \u1077 \u1081 \u1085  \u1078 \u1072 \u1088 \u1072 \u1084 \u1076 \u1099 !")\
    else:\
        print("\uc0\u1041 \u1083 \u1086 \u1082 \u1095 \u1077 \u1081 \u1085  \u1078 \u1072 \u1088 \u1072 \u1084 \u1089 \u1099 \u1079 !")}