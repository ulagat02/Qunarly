        print(f"  \uc0\u1044 \u1077 \u1088 \u1077 \u1082 : \{block.data\}")\
        print(f"  \uc0\u1061 \u1101 \u1096 : \{block.hash\}")\
        print(f"  \uc0\u1040 \u1083 \u1076 \u1099 \u1187 \u1171 \u1099  \u1093 \u1101 \u1096 : \{block.previous_hash\}")\
        print("-" * 50)\
