    blockchain.add_block("\uc0\u1041 \u1110 \u1088 \u1110 \u1085 \u1096 \u1110  \u1090 \u1088 \u1072 \u1085 \u1079 \u1072 \u1082 \u1094 \u1080 \u1103 ")\
    blockchain.add_block("\uc0\u1045 \u1082 \u1110 \u1085 \u1096 \u1110  \u1090 \u1088 \u1072 \u1085 \u1079 \u1072 \u1082 \u1094 \u1080 \u1103 ")\
    blockchain.add_block("\uc0\u1198 \u1096 \u1110 \u1085 \u1096 \u1110  \u1090 \u1088 \u1072 \u1085 \u1079 \u1072 \u1082 \u1094 \u1080 \u1103 ")\
\
    # \uc0\u1041 \u1083 \u1086 \u1082 \u1090 \u1072 \u1088 \u1076 \u1099  \u1082 \u1257 \u1088 \u1089 \u1077 \u1090 \u1091 \
    for block in blockchain.chain:\
