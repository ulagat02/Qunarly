\f0\fs24 \cf0 import hashlib\
import time\
\
# \uc0\u1041 \u1083 \u1086 \u1082  \u1179 \u1201 \u1088 \u1099 \u1083 \u1099 \u1084 \u1099 \
class Block:\
    def __init__(self, index, previous_hash, timestamp, data):\
        self.index = index  # \uc0\u1041 \u1083 \u1086 \u1082 \u1090 \u1099 \u1187  \u1085 \u1257 \u1084 \u1110 \u1088 \u1110 \
        self.previous_hash = previous_hash  # \uc0\u1040 \u1083 \u1076 \u1099 \u1187 \u1171 \u1099  \u1073 \u1083 \u1086 \u1082 \u1090 \u1099 \u1187  \u1093 \u1101 \u1096 \u1110 \
        self.timestamp = timestamp  # \uc0\u1059 \u1072 \u1179 \u1099 \u1090  \u1073 \u1077 \u1083 \u1075 \u1110 \u1089 \u1110 \
        self.data = data  # \uc0\u1041 \u1083 \u1086 \u1082 \u1090 \u1072 \u1171 \u1099  \u1076 \u1077 \u1088 \u1077 \u1082 \u1090 \u1077 \u1088 \
        self.hash = self.calculate_hash()  # \uc0\u1041 \u1083 \u1086 \u1082 \u1090 \u1099 \u1187  \u1093 \u1101 \u1096 \u1110 \
\
    # \uc0\u1061 \u1101 \u1096 \u1090 \u1110  \u1077 \u1089 \u1077 \u1087 \u1090 \u1077 \u1091  \u1241 \u1076 \u1110 \u1089 \u1110 \
    def calculate_hash(self):\
        block_string = f"\{self.index\}\{self.previous_hash\}\{self.timestamp\}\{self.data\}"\
        return hashlib.sha256(block_string.encode()).hexdigest()\
\
# \uc0\u1041 \u1083 \u1086 \u1082 \u1095 \u1077 \u1081 \u1085  \u1179 \u1201 \u1088 \u1099 \u1083 \u1099 \u1084 \u1099 \
class Blockchain:\
    def __init__(self):\
        self.chain = [self.create_genesis_block()]  # \uc0\u1040 \u1083 \u1171 \u1072 \u1096 \u1179 \u1099  \u1073 \u1083 \u1086 \u1082 \u1090 \u1099  \u1078 \u1072 \u1089 \u1072 \u1091 \
\
    # \uc0\u1040 \u1083 \u1171 \u1072 \u1096 \u1179 \u1099  (\u1075 \u1077 \u1085 \u1077 \u1079 \u1080 \u1089 ) \u1073 \u1083 \u1086 \u1082 \
    def create_genesis_block(self):\
        return Block(0, "0", time.time(), "Genesis Block")\
\
    # \uc0\u1057 \u1086 \u1187 \u1171 \u1099  \u1073 \u1083 \u1086 \u1082 \u1090 \u1099  \u1072 \u1083 \u1091 \
    def get_latest_block(self):\
        return self.chain[-1]\
\
    # \uc0\u1046 \u1072 \u1187 \u1072  \u1073 \u1083 \u1086 \u1082  \u1179 \u1086 \u1089 \u1091 \
    def add_block(self, data):\
        latest_block = self.get_latest_block()\
        new_block = Block(len(self.chain), latest_block.hash, time.time(), data)\
        self.chain.append(new_block)\
\
    # \uc0\u1041 \u1083 \u1086 \u1082 \u1095 \u1077 \u1081 \u1085 \u1085 \u1110 \u1187  \u1078 \u1072 \u1088 \u1072 \u1084 \u1076 \u1099 \u1083 \u1099 \u1171 \u1099 \u1085  \u1090 \u1077 \u1082 \u1089 \u1077 \u1088 \u1091 \
    def is_chain_valid(self):\
        for i in range(1, len(self.chain)):\
            current_block = self.chain[i]\
            previous_block = self.chain[i - 1]\
\
            # \uc0\u1041 \u1083 \u1086 \u1082 \u1090 \u1099 \u1187  \u1093 \u1101 \u1096 \u1110  \u1076 \u1201 \u1088 \u1099 \u1089  \u1087 \u1072 ?\
            if current_block.hash != current_block.calculate_hash():\
                return False\
\
            # \uc0\u1040 \u1083 \u1076 \u1099 \u1187 \u1171 \u1099  \u1073 \u1083 \u1086 \u1082 \u1090 \u1099 \u1187  \u1093 \u1101 \u1096 \u1110  \u1076 \u1201 \u1088 \u1099 \u1089  \u1073 \u1072 \u1081 \u1083 \u1072 \u1085 \u1099 \u1089 \u1179 \u1072 \u1085  \u1073 \u1072 ?\
            if current_block.previous_hash != previous_block.hash:\
                return False\
\
        return True\
\
# \uc0\u1041 \u1083 \u1086 \u1082 \u1095 \u1077 \u1081 \u1085 \u1076 \u1110  \u1089 \u1099 \u1085 \u1072 \u1091 \
if __name__ == "__main__":\
    blockchain = Blockchain()\
\
